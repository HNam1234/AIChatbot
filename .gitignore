# Local/generated pipeline data. Keep .gitkeep only; do not commit PDFs, assets, trees, or temp logs.
data/uploads/*
data/converted/*
data/state/*
data/tmp/*
!data/uploads/.gitkeep
!data/converted/.gitkeep
!data/state/.gitkeep
!data/tmp/.gitkeep
