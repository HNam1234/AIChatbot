{
  "name": "aichatbot-local-pdf-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Local PDF parser pipeline with PageIndex tree generation and agentic Q&A.",
  "main": "dist/mainFlow.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "parse": "tsx src/mainFlow.ts",
    "parse:batch": "tsx src/mainFlow.ts --batch",
    "chat": "tsx src/mainFlow.ts --mode chat",
    "agent": "tsx src/mainFlow.ts --mode agent",
    "dev": "tsx src/server/server.ts",
    "dev:watch": "tsx watch src/server/server.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.7.284"
  }
}
